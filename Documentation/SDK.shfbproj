    <ComponentConfigurations>
      <ComponentConfig id="Comments Index Data (SQL Cache)" enabled="True">
        <component id="Comments Index Data (SQL Cache)">
  <index name="comments" value="/doc/members/member" key="@name" cache="30" localCacheSize="2500" cacheProject="false" connectionString="Data Source=WSAPW8\SQL2012EXPRESS;Initial Catalog=Sandcastle;Integrated Security=True;Application Name=&quot;Sandcastle BuildAssembler&quot;">
